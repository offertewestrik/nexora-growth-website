{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/cfg/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/robots.txt"
    },
    {
      "source": "/llms.txt",
      "destination": "/seo/llms.txt"
    },
    {
      "source": "/:p(360|demo-adcm|demo-alureh|demo-crm|demo-dakdekker|demo-opbouwineenweek|demo-wellnesstuinier|demos|jacht-360-proef|jacht-dashboard|jachtaanvraag|ng-crm|offerte-dakopbouw|opvolging-engine|plattegrond|render-controle|tekenprogramma-demo|van-oss-vloerenstudio)",
      "destination": "https://next-growth-prefabselect.vercel.app/:p.html"
    },
    {
      "source": "/:p(360|demo-adcm|demo-alureh|demo-crm|demo-dakdekker|demo-opbouwineenweek|demo-wellnesstuinier|demos|jacht-360-proef|jacht-dashboard|jachtaanvraag|ng-crm|offerte-dakopbouw|opvolging-engine|plattegrond|render-controle|tekenprogramma-demo|van-oss-vloerenstudio).html",
      "destination": "https://next-growth-prefabselect.vercel.app/:p.html"
    },
    {
      "source": "/:d(add|ads|content|demo|docs|film|homepage-mantelzorg|proef|social|tools)/:path*",
      "destination": "https://next-growth-prefabselect.vercel.app/:d/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://next-growth-prefabselect.vercel.app/assets/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://next-growth-prefabselect.vercel.app/api/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Bingbot|DuckDuckBot|YandexBot|Applebot|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|CCBot|Bytespider|Amazonbot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot|cohere-ai|meta-externalagent|YouBot|Diffbot).*"
        }
      ],
      "destination": "/seo/index"
    },
    {
      "source": "/",
      "destination": "/app"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Bingbot|DuckDuckBot|YandexBot|Applebot|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|CCBot|Bytespider|Amazonbot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot|cohere-ai|meta-externalagent|YouBot|Diffbot).*"
        }
      ],
      "destination": "/seo/:slug"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "destination": "/app"
    }
  ],
  "redirects": [
